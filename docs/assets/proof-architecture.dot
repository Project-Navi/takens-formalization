digraph proof_architecture {
  rankdir=TB
  bgcolor="transparent"
  newrank=true
  node [fontname="DM Sans" fontsize=11 style=filled fillcolor="#1a1a1a"
        fontcolor="#e8e4de" color="#2a2a2a" shape=box margin="0.15,0.08"
        penwidth=1.5]
  edge [color="#7eb8a8" arrowsize=0.6 penwidth=1.2]

  subgraph cluster_finite {
    label="Finite state spaces and ordinal codes"
    labeljust=l
    fontname="Fraunces"
    fontsize=14
    fontcolor="#7eb8a8"
    color="#2a2a2a"
    style=dashed
    margin=16

    DelayWindow [label="DelayWindow\ndelay map, orbit separation,\ncoincidence length, horizon"
                 color="#7eb8a8"]
    IteratePeriod [label="IteratePeriod\nperiod bridge"]
    TakensDiscrete [label="TakensDiscrete\nsharp bound N - 1,\ndecision procedure"]
    Reconstruction [label="Reconstruction\ndynamics on the image"]
    OrdinalPattern [label="OrdinalPattern\nordinal patterns"]
    OrdinalTakens [label="OrdinalTakens\nordinal delay map,\npattern counts"]
    OrdinalEntropy [label="OrdinalEntropy\npattern entropy"]
    OrdinalQuotient [label="OrdinalQuotient\nwhat the code retains"]
  }

  subgraph cluster_sard {
    label="Sard's theorem"
    labeljust=l
    fontname="Fraunces"
    fontsize=14
    fontcolor="#7eb8a8"
    color="#2a2a2a"
    style=dashed
    margin=16

    SardInfra [label="SardInfra\ncritical values; C¹ equal-\nand low-dimensional cases"]
    SardMoreira [label="ForMathlib/SardMoreira\nMoreira's theorem\n(ported, 19 files)"
                 color="#d4a574" fontcolor="#d4a574"]
    Sard [label="Sard\nall dimensions, C^r,\nr ≥ dim E - dim F + 1"
          color="#7eb8a8"]
  }

  subgraph cluster_smooth {
    label="Delay maps on manifolds"
    labeljust=l
    fontname="Fraunces"
    fontsize=14
    fontcolor="#7eb8a8"
    color="#2a2a2a"
    style=dashed
    margin=16

    SmoothTakens [label="SmoothTakens\ncompact embedding chain"]
    SmoothDelay [label="SmoothDelay\ndifferential, immersion,\nC^r embeddings"]
    CircleDelay [label="CircleDelay\nquarter-turn example"]
    Avoidance [label="ForMathlib/Avoidance\nparametric avoidance"]
    GenericFamily [label="ForMathlib/GenericFamily\ngeneric immersion\nand separation"]
    DelayPerturbation [label="DelayPerturbation\ngeneric observations\nin a finite family"]
    DelaySpan [label="DelaySpan\nspan conditions,\noverlapping windows"]
    PolynomialNull [label="ForMathlib/PolynomialNull\nnull zero sets,\ninjective members"]
    DelayPeriodic [label="DelayPeriodic\nshort periodic orbits"]
    InterpolatingFamily [label="InterpolatingFamily\nfixed-map Takens theorem,\nalmost every member"]
    JetTopology [label="JetTopology\nweak C^n topology\nthrough chart jets"]
    EmbeddingStability [label="EmbeddingStability\nstability of embeddings"]
    GenericObservation [label="GenericObservation\nfixed-map Takens theorem,\nopen dense in C²"
                        color="#7eb8a8"]
  }

  subgraph cluster_pairs {
    label="Generic pairs"
    labeljust=l
    fontname="Fraunces"
    fontsize=14
    fontcolor="#7eb8a8"
    color="#2a2a2a"
    style=dashed
    margin=16

    WeakTopology [label="WeakTopology, WeakComposition\nC^n topology on\ndiffeomorphisms"]
    GenericPair [label="GenericPair\ngood pairs are open"]
    PeriodicGood [label="PeriodicGood, ForMathlib/GoodMatrix\ngood periodic points give\nthe periodic conditions"]
    PeriodicNull [label="ForMathlib/PeriodicNull\nlocal null lemma (Fubini)"]
    ChartPerturbation [label="ChartPerturbation\nbump perturbations\nin a chart"]
    PatchStability [label="NearStability, PatchStability\nC⁰ margins, persistence"]
    KupkaSmale [label="PatchPerturbation, KupkaSmale\nKupka–Smale density"]
    GenericPairTakens [label="GenericPairTakens\nTakens' theorem\nfor generic pairs"
                       color="#7eb8a8"]
  }

  DelayWindow -> IteratePeriod
  DelayWindow -> TakensDiscrete
  DelayWindow -> Reconstruction
  DelayWindow -> OrdinalTakens
  OrdinalPattern -> OrdinalTakens
  OrdinalTakens -> OrdinalEntropy
  OrdinalTakens -> OrdinalQuotient

  SardInfra -> Sard
  SardMoreira -> Sard

  DelayWindow -> SmoothTakens
  DelayWindow -> SmoothDelay
  SmoothDelay -> CircleDelay
  SmoothDelay -> DelayPerturbation
  Avoidance -> GenericFamily
  GenericFamily -> DelayPerturbation
  DelayPerturbation -> DelaySpan
  DelaySpan -> DelayPeriodic
  PolynomialNull -> DelayPeriodic
  DelayPeriodic -> InterpolatingFamily
  DelayPerturbation -> EmbeddingStability
  JetTopology -> EmbeddingStability
  EmbeddingStability -> GenericObservation
  InterpolatingFamily -> GenericObservation
  EmbeddingStability -> GenericPair
  WeakTopology -> GenericPair
  WeakTopology -> ChartPerturbation
  WeakTopology -> PatchStability
  DelayPeriodic -> PeriodicGood
  PeriodicGood -> PatchStability
  PeriodicGood -> ChartPerturbation
  PeriodicNull -> KupkaSmale
  ChartPerturbation -> KupkaSmale
  PatchStability -> KupkaSmale
  KupkaSmale -> GenericPairTakens
  GenericPair -> GenericPairTakens
  GenericObservation -> GenericPairTakens

  { rank=same; IteratePeriod; TakensDiscrete; Reconstruction; OrdinalTakens; SmoothTakens;
    SmoothDelay; GenericFamily; Sard }
}
